{
  "manifest_version": 3,
  "name": "Gradescope to ICS",
  "version": "1.1.0",
  "description": "Click the toolbar icon on a Gradescope course page to gather assignments into a memory, then download them all as a single .ics calendar file.",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://www.gradescope.com/*"
  ],

  "action": {
    "default_title": "Gradescope to ICS",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["https://www.gradescope.com/courses/*"],
      "js": ["content/gradescope-ics.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
